# Copy to hosting.env (0600) on the new host. Never commit real credentials.
RADAR_HOSTING_HOME=/srv/martech-radar/workspace
RADAR_BACKUP_HOME=/srv/martech-radar-backups
RADAR_GATEWAY_TOKEN_FILE=/srv/martech-radar-secrets/preparation-token
RADAR_PUBLIC_HOST=radar.example.com
# Fill verified immutable image IDs/digests from the build/release record.
RADAR_WEB_IMAGE=
RADAR_COLLECTOR_IMAGE=
RADAR_PROXY_IMAGE=caddy@sha256:36c24ad91a7ff7bc4c87fe22bfa8df3c4b18da0773d73fc12ee2c52b98c0bb7e

# 3k/5k readiness: shared scan concurrency stays 3. Validate on the chosen VM.
RADAR_COLLECTOR_CPUS=3
RADAR_COLLECTOR_MEMORY=6g
RADAR_BACKUP_KEEP=3
RADAR_BACKUP_MAX_GIB=80
RADAR_BACKUP_MIN_FREE_GIB=2
