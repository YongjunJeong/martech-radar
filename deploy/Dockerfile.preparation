# Build from this repository after exporting the KB separately. No KB data or
# credentials enter the image; only pinned runtime dependencies are installed.
ARG RADAR_WEB_IMAGE
FROM ${RADAR_WEB_IMAGE}
USER root
COPY deploy/requirements.preparation.lock /opt/radar/requirements.preparation.lock
RUN pip install --no-cache-dir -r /opt/radar/requirements.preparation.lock
COPY deploy/preparation_healthcheck.py /opt/radar/preparation_healthcheck.py
USER radar
ENTRYPOINT ["python", "-m", "web.preparation_hosted"]
CMD []
EXPOSE 8612
HEALTHCHECK --interval=60s --timeout=30s --start-period=180s --retries=3 \
    CMD ["python", "/opt/radar/preparation_healthcheck.py"]
